# Copy this file to .env for local development and replace the password.
POSTGRES_DB=qinghuai
POSTGRES_USER=qinghuai
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

QINGHUAI_PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://qinghuai:replace-with-a-local-password@127.0.0.1:5432/qinghuai
DATABASE_ECHO=false
MEMORY_EMBEDDING_DIMENSIONS=384

# AI remains configured independently. Never commit a real key.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=doubao-seed-2.0-lite
ARK_API_KEY=
