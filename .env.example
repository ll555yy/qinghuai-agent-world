# Copy this file to .env for local development and replace the password.
POSTGRES_DB=qinghuai
POSTGRES_USER=qinghuai
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

QINGHUAI_PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://qinghuai:replace-with-a-local-password@127.0.0.1:5432/qinghuai
DATABASE_ECHO=false

# Chat context compaction. The first reached threshold rolls the older
# prefix into a neutral summary while preserving recent verbatim messages.
SEGMENT_SUMMARY_THRESHOLD=20
SEGMENT_SUMMARY_TOKEN_THRESHOLD=2400
SEGMENT_RECENT_MESSAGES=8
SEGMENT_BOUNDARY_CARRYOVER_MESSAGES=4
# Used by both private-memory vector recall and per-NPC speech-example retrieval.
# Live-probed through Agent Plan: the resolved model returns 2048 dimensions.
# Store full vectors; pgvector indexes a halfvec cast because HNSW vector
# indexes support at most 2000 dimensions.
ARK_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_EMBEDDING_MODEL=doubao-embedding-vision
ARK_EMBEDDING_DIMENSIONS=2048

# AI remains configured independently. Never commit a real key.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=doubao-seed-2.0-lite
# All physical Ark requests share this process-wide cap. Chat decisions and
# speech still run concurrently within the cap.
ARK_MODEL_MAX_CONCURRENCY=6
# A silent conversation gets one final model check after this pause.
CHAT_COOLDOWN_SECONDS=12
# Same-round NPC messages are generated concurrently, then published with a
# deterministic natural-looking gap in this range.
CHAT_PUBLISH_DELAY_MIN_SECONDS=1.2
CHAT_PUBLISH_DELAY_MAX_SECONDS=3.0
# One stalled NPC degrades independently instead of blocking the whole round.
CHAT_MODEL_CALL_TIMEOUT_SECONDS=45
# Evaluation-only LLM Judge. It is never wired into the production runtime.
ARK_JUDGE_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_JUDGE_MODEL=doubao-seed-2.1-turbo
# Optional: use a standard Model API key when Candidate uses an Agent Plan key.
ARK_JUDGE_API_KEY=
ARK_API_KEY=
